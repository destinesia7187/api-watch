# Generate real random local values with: python -m api_watch init-env
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///var/api-watch.db
SESSION_SECRET=
ENCRYPTION_KEY=
ENCRYPTION_KEY_ID=local-v1
POSTGRES_PASSWORD=
REGISTRATION_ENABLED=true
CHECK_CONCURRENCY=10
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=API Watch <noreply@example.com>
SMTP_STARTTLS=true
LOG_LEVEL=INFO

## Set only to the exact trusted reverse-proxy addresses when deploying behind one.
FORWARDED_ALLOW_IPS=127.0.0.1
